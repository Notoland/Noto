// Interfaces in Noto 0.16, and what they promise.
//
//     noto test examples/interfaces.noto
//     noto run examples/interfaces.noto
//
// An interface names the members a type promises to provide. Conformance is
// nominal and declared where the type is declared, so "does Version implement
// Comparable?" is answered by reading Version's first line. The reasoning, and
// what is still missing, is in docs/rfcs/0003-interfaces-and-bounds.md.
//
// A bound — `<T: Comparable>` — is that promise attached to a type parameter,
// and it is what lets generic code do more with a T than move it around.
//
// `largest` below is compiled ONCE, not once per type. It reaches compareTo
// through a witness: a static table of the concrete type's implementations,
// passed as a hidden argument. That is the only argument in the language the
// source does not show, and the only thing generics do that is not free —
// one pointer per bound, paid by code that uses one.
//
// `Comparable` and `Hashable` are not declared anywhere below, and need no
// import: nothing can open `class Int` or `class String` to write
// `compareTo` or `hash` on them, so the compiler knows both by name and every
// module sees them for free. `Int`, the sized integers, `Byte`, `Char` and
// `String` implement both; `Bool` implements only `Hashable`. That fixed
// table is the whole of it — see docs/rfcs/0003-interfaces-and-bounds.md.

/// Something that knows how big it is.
export interface Sized {
    val size: Int
}

export class Version(val major: Int, val minor: Int): Comparable {
    export fn compareTo(other: Version): Int {
        if major != other.major { return major - other.major }
        return minor - other.minor
    }

    export fn text(): String = "${major}.${minor}"
}

/// A type may promise more than one thing.
export class Buffer(val size: Int): Comparable, Sized {
    export fn compareTo(other: Buffer): Int = size - other.size
}

/// Only a `Comparable` reaches this. `Circle` would be rejected at the call
/// with NOTO0413, naming what it would have to implement.
export fn firstOf<T: Comparable>(xs: [T]): T = xs[0]

/// The payoff: one compiled function, ordering values of any type that
/// promised it can be ordered.
export fn largest<T: Comparable>(xs: [T]): T {
    var best = xs[0]
    for x in xs {
        if best.compareTo(x) < 0 { best = x }
    }
    return best
}

/// A bounded function may pass its own T on: it hands over the witness it was
/// given rather than building one, because it does not know the type either.
export fn largestOfThree<T: Comparable>(a: T, b: T, c: T): T = largest([a, b, c])

/// `Hashable` is the other half of the built-in table: everything
/// `Comparable` reaches, plus `Bool`, minus nothing — see the table above.
export fn hashOf<T: Hashable>(x: T): Int = x.hash()

/// A bound flows through a generic class the same way: `Holder(Circle(1))`
/// is rejected at the construction.
///
/// A class cannot yet reach its bound the way a function can. A function is
/// handed its witness as an argument; a class would have to store one in a
/// hidden field, written at construction, and that is not built — so
/// `item.size` inside a method here is still an unknown member.
export class Holder<T: Sized>(val item: T)

test "an implementer's method is an ordinary method" {
    val a = Version(1, 4)
    val b = Version(1, 9)
    assert(a.compareTo(b) < 0)
    assert(b.compareTo(a) > 0)
    assert(a.compareTo(Version(1, 4)) == 0)
}

test "the major number wins over the minor one" {
    assert(Version(2, 0).compareTo(Version(1, 99)) > 0)
}

test "a class can implement two interfaces" {
    val small = Buffer(8)
    val large = Buffer(64)
    assert(small.compareTo(large) < 0)
    // `size` satisfies Sized by being an ordinary field.
    assert(small.size == 8)
}

test "a bound lets only an implementer through" {
    // Both of these are `Comparable`, so both reach `firstOf`.
    assert(firstOf([Version(1, 0), Version(2, 0)]).major == 1)
    assert(firstOf([Buffer(8), Buffer(16)]).size == 8)

    // firstOf([Circle(1)]) would be NOTO0413: Circle is not Comparable.
}

test "the built-in types reach the same bound, with no declaration at all" {
    // `largest` above is the RFC's own motivating example: it is compiled
    // once, and an `Int` and a `String` share that one compiled copy with
    // `Version` and `Buffer` — four different witnesses, one function.
    assert(largest([3, 1, 4, 1, 5, 9]) == 9)
    assert(largest(["pear", "apple", "quince"]) == "quince")
}

test "hash reaches Int, String and Bool, but compareTo does not reach Bool" {
    assert(hashOf(5) == 5)
    assert(hashOf(true) == 1)
    // hashOf reused for the receiver's own words: a `String`'s hash is a
    // running total over its bytes, not its identity.
    assert(hashOf("ab") == 97 * 31 + 98)

    // largest([true, false]) would be NOTO0413: Bool is not Comparable.
}

test "a bound reaches the members it promised" {
    assert(largest([Version(1, 4), Version(2, 0), Version(0, 9)]).major == 2)
    // The same compiled `largest`, a different type, a different table.
    assert(largest([Buffer(8), Buffer(64), Buffer(16)]).size == 64)
}

test "a witness can be passed on rather than built" {
    assert(largestOfThree(Version(1, 0), Version(3, 0), Version(2, 0)).major == 3)
}

test "a bound on a class is checked where it is constructed" {
    assert(Holder(Buffer(32)).item.size == 32)
}

test "conformance costs nothing at runtime" {
    // Buffer is laid out exactly as it would be without the interfaces: one
    // field, at offset zero. Nothing is stored to say what it implements.
    assert(Buffer(3).size == 3)
}

fn main() {
    val current = Version(0, 14)
    val next = Version(0, 15)
    println("${current.text()} -> ${next.text()}")

    if current.compareTo(next) < 0 {
        println("ainda falta chegar em ${next.text()}")
    }

    println("buffer de ${Buffer(64).size} bytes")

    println("o maior de tres numeros: ${largest([3, 1, 4])}")
    println("a maior de tres palavras: ${largest(["pera", "maca", "uva"])}")
}

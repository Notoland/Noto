// Objects in Noto 0.3. Run the tests with `noto test examples/point.noto`.

class Point(val x: Int, val y: Int)

class Counter(var count: Int) {
    fn bump() {
        this.count += 1
    }

    fn add(n: Int) {
        this.count += n
    }
}

// A field declared in the class body carries its own initialiser, which may
// read the constructor's parameters. A property is read like a field but
// computed by its `get`.
class Segment(val from: Point, val to: Point) {
    val span: Int = distance(from.x, to.x) + distance(from.y, to.y)

    val isPoint: Bool { get = this.span == 0 }
}

class Line(val from: Point, val to: Point) {
    // A method may call another method of the same class.
    fn length(): Int = this.horizontal() + this.vertical()

    fn horizontal(): Int = distance(this.from.x, this.to.x)

    fn vertical(): Int = distance(this.from.y, this.to.y)

    fn describe(): String = "(${this.from.x}, ${this.from.y}) -> (${this.to.x}, ${this.to.y})"
}

fn distance(from: Int, to: Int): Int {
    val difference = to - from
    if difference < 0 { return -difference }
    return difference
}

test "a field holds what the constructor was given" {
    val p = Point(3, 4)
    assert(p.x == 3)
    assert(p.y == 4)
}

test "a method reassigns a var field through this" {
    val counter = Counter(0)
    counter.bump()
    counter.bump()
    assert(counter.count == 2)
}

test "a method takes its own parameters after the receiver" {
    val counter = Counter(1)
    counter.add(41)
    assert(counter.count == 42)
}

test "an object is a reference, so two names see one object" {
    val counter = Counter(0)
    val same = counter
    same.bump()
    assert(counter.count == 1)
}

test "a field can hold another object" {
    val line = Line(Point(1, 1), Point(4, 5))
    assert(line.from.x == 1)
    assert(line.length() == 7)
}

test "a method may call another method of the same class" {
    val line = Line(Point(0, 0), Point(3, 4))
    assert(line.horizontal() == 3)
    assert(line.vertical() == 4)
    assert(line.length() == 7)
}

test "a body field is initialised from the constructor's parameters" {
    val s = Segment(Point(1, 1), Point(4, 5))
    assert(s.span == 7)
}

test "a property is computed on each read" {
    assert(Segment(Point(0, 0), Point(0, 0)).isPoint)
    assert(!Segment(Point(0, 0), Point(1, 0)).isPoint)
}

fn main() {
    val line = Line(Point(0, 0), Point(3, 4))
    println("${line.describe()} has length ${line.length()}")
}

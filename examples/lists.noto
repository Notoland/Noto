// Lists in Noto 0.10. Run the tests with `noto test examples/lists.noto`.
//
// A list is a header — length, capacity, and a pointer to its elements — so
// `push` can replace the buffer without invalidating anyone's pointer to the
// list. Every index is checked before it is used: reading past the end ends
// the process rather than returning whatever the allocator last left there.

class Point(val x: Int, val y: Int)

export fn sum(xs: [Int]): Int {
    var total = 0
    for x in xs { total += x }
    return total
}

export fn largest(xs: [Int]): Int {
    assert(xs.length > 0)
    var best = xs[0]
    for x in xs {
        if x > best { best = x }
    }
    return best
}

export fn evens(limit: Int): [Int] {
    val all: [Int] = []
    var n = 0
    while n < limit {
        all.push(n)
        n += 1
    }
    return all.filter({ it % 2 == 0 })
}

export fn joined(parts: [String], separator: String): String {
    var out = ""
    var index = 0
    while index < parts.length {
        if index > 0 { out += separator }
        out += parts[index]
        index += 1
    }
    return out
}

test "a list knows how long it is" {
    assert([1, 2, 3].length == 3)
    val empty: [Int] = []
    assert(empty.length == 0)
}

test "elements are read by index" {
    val xs = [10, 20, 30]
    assert(xs[0] == 10)
    assert(xs[2] == 30)
}

test "an element can be written" {
    val xs = [1, 2, 3]
    xs[1] = 99
    assert(xs[1] == 99)
    xs[1] += 1
    assert(xs[1] == 100)
}

test "a for walks every element" {
    assert(sum([1, 2, 3, 4]) == 10)
    assert(sum([]) == 0)
    assert(largest([3, 9, 4]) == 9)
}

test "a list may hold anything a binding may" {
    val points = [Point(1, 2), Point(3, 4)]
    assert(points[1].y == 4)

    val grid = [[1, 2], [3]]
    assert(grid[0][1] == 2)
    assert(grid[1].length == 1)
}

test "a list grows as it is pushed to" {
    val xs: [Int] = []
    assert(xs.length == 0)
    xs.push(10)
    xs.push(20)
    assert(xs.length == 2)
    assert(xs[1] == 20)
}

test "growing past the first buffer keeps every element" {
    val xs = evens(20)
    assert(xs.length == 10)
    assert(xs[0] == 0)
    assert(xs[9] == 18)
    assert(sum(xs) == 90)
}

test "a literal can be pushed to as well" {
    val xs = [1, 2]
    xs.push(3)
    assert(xs.length == 3)
    assert(xs[0] == 1)
    assert(xs[2] == 3)
}

test "map produces one element per element" {
    assert(sum([1, 2, 3].map({ it * 2 })) == 12)
    assert([1, 2].map({ n: Int -> "n=$n" })[1] == "n=2")

    val factor = 10
    assert([1, 2].map({ it * factor })[0] == 10)
}

test "filter keeps what its function accepts" {
    assert(sum([1, 2, 3, 4].filter({ it % 2 == 0 })) == 6)
    assert([1, 2, 3].filter({ it > 10 }).length == 0)
}

test "each visits every element" {
    val seen: [Int] = []
    [1, 2, 3].each({ n: Int -> seen.push(n) })
    assert(seen.length == 3)
    assert(seen[2] == 3)
}

test "strings join through a list" {
    assert(joined(["a", "b", "c"], "-") == "a-b-c")
    assert(joined([], ",") == "")
}

fn main() {
    val readings = [12, 7, 30, 4]
    println("${readings.length} readings")
    println("total ${sum(readings)}, largest ${largest(readings)}")
    println(joined(["ana", "joão", "maria"], ", "))
    println("evens under 20: ${joined_ints(evens(20))}")
}

// What this used to be, before lambdas:
//
//     val parts: [String] = []
//     for x in xs { parts.push(x.toString()) }
//     return joined(parts, " ")
fn joined_ints(xs: [Int]): String = joined(xs.map({ it.toString() }), " ")
